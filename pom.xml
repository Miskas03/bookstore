<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.example</groupId>
	<artifactId>bookstoremiska</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>bookstoremiska</name>
	<description/>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<java.version>17</java.version>
	</properties>
	
	<dependencies>

	<!-- Actuator: valmiit endpointit sovelluksen tilan seurantaan (esim. /actuator/health) -->
	<dependency>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-actuator</artifactId>
	</dependency>


	<!-- TIETOKANTA DEPENDENCYT ALKAA -->

	<!-- Spring Data JPA: tietokannan käsittely Java-olioina (entityt, repositoryt, Hibernate) -->
	<dependency>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-data-jpa</artifactId>
	</dependency>

	<!-- Spring Data REST: julkaisee repositoryt automaattisesti REST-rajapintana -->
	<dependency>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-data-rest</artifactId>
	</dependency>

	<!-- H2: muistinvarainen tietokanta kehitykseen ja testaukseen -->
	<dependency>
		<groupId>com.h2database</groupId>
		<artifactId>h2</artifactId>
	</dependency>

	<!-- H2 console: selainpohjainen käyttöliittymä H2-tietokannan katseluun (/h2-console) -->
	<dependency>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-h2console</artifactId>
	</dependency>

	<!-- TIETOKANTA DEPENDENCYT LOPPUU -->

	<!-- Spring Security: kirjautuminen, käyttäjien autentikointi ja pääsynhallinta -->
	<dependency>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-security</artifactId>
		
	</dependency>

	<dependency>
    	<groupId>org.thymeleaf.extras</groupId>
    	<artifactId>thymeleaf-extras-springsecurity6</artifactId>
	</dependency>

	<!-- Thymeleaf: HTML-sivupohjat, joihin voi tuoda dataa Java-koodista -->
	<dependency>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-thymeleaf</artifactId>
	</dependency>

	<!-- Web MVC: web-sovelluksen perusta (controllerit, reitit, sisäänrakennettu Tomcat) -->
	<dependency>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-webmvc</artifactId>
	</dependency>

	<!-- DevTools: automaattinen uudelleenkäynnistys koodimuutosten jälkeen, vain kehityskäyttöön -->
	<dependency>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-devtools</artifactId>
		<scope>runtime</scope>
		<optional>true</optional>
	</dependency>

	<!-- Thymeleaf-testit: työkalut Thymeleaf-näkymien testaamiseen -->
	<dependency>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-thymeleaf-test</artifactId>
		<scope>test</scope>
	</dependency>

	<!-- Web MVC -testit: työkalut controllerien testaamiseen (esim. MockMvc) -->
	<dependency>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-webmvc-test</artifactId>
		<scope>test</scope>
	</dependency>
</dependencies>


	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
